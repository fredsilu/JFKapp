{
  "cli": {
    "version": ">= 16.1.0",
    "appVersionSource": "remote"
  },

  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development"
      }
    },

    "beta": {
      "distribution": "internal",

      "android": {
        "buildType": "apk"
      },

      "env": {
        "EXPO_PUBLIC_APP_ENV": "test"
      }
    },

    "preview": {
      "android": {
        "buildType": "apk"
      },

      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview"
      }
    },

    "production": {
      "autoIncrement": true,

      "env": {
        "EXPO_PUBLIC_APP_ENV": "production"
      }
    }
  },

  "submit": {
    "production": {}
  }
}