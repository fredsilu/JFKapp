{
  "name": "jfkapp",
  "main": "expo-router/entry",
  "version": "3.2.1",
  "scripts": {
    "start": "npm run start:test",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "start:test": "dotenv -e .env.test -- expo start --clear",
    "start:production": "dotenv -e .env.production -- expo start --clear",
    "android:test": "dotenv -e .env.test -- expo run:android",
    "android:production": "dotenv -e .env.production -- expo run:android",
    "web:test": "dotenv -e .env.test -- expo start --web",
    "data:migrate:seed:prod": "dotenv -e .env.production -- cross-env APP_ENV=production tsx scripts/dataManager/restoreSeedToProduction.ts",
    "web:production": "dotenv -e .env.production -- expo start --web",
    "build:web:test": "dotenv -e .env.test -- expo export --platform web",
    "build:web:production": "dotenv -e .env.production -- cross-env EXPO_PUBLIC_APP_ENV=production expo export --platform web --clear",
    "data:backup:test": "dotenv -e .env.test -- cross-env APP_ENV=test tsx scripts/dataManager/backup.ts",
    "data:restore:test": "dotenv -e .env.test -- cross-env APP_ENV=test tsx scripts/dataManager/restore.ts",
    "data:reset:test": "dotenv -e .env.test -- cross-env APP_ENV=test tsx scripts/dataManager/reset.ts",
    "data:backup:prod": "dotenv -e .env.production -- cross-env APP_ENV=production tsx scripts/dataManager/backup.ts",
    "data:list:test": "dotenv -e .env.test -- cross-env APP_ENV=test tsx scripts/dataManager/listBackups.ts",
    "data:list:prod": "dotenv -e .env.production -- cross-env APP_ENV=production tsx scripts/dataManager/listBackups.ts",
    "data:verify:test": "dotenv -e .env.test -- cross-env APP_ENV=test tsx scripts/dataManager/verifyBackup.ts",
    "data:verify:prod": "dotenv -e .env.production -- cross-env APP_ENV=production tsx scripts/dataManager/verifyBackup.ts",
    "import:ingredients:dry": "tsx scripts/importIngredients.ts --dry",
    "import:ingredients:test": "tsx scripts/importIngredients.ts",
    "import:ingredients:prod": "dotenv -e .env.production -- tsx scripts/importIngredients.ts"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  },
  "dependencies": {
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/slider": "5.0.1",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "dotenv": "^17.4.2",
    "expo": "~54.0.34",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.10.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-vector-icons": "^10.2.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "svg.js": "^2.7.1",
    "tsx": "^4.22.3",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/firebase": "^2.4.32",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "^18.3.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "private": true
}